# 复制为 .env.production 后填写。不得提交真实值。
HR_ENVIRONMENT=production
HR_DOMAIN=hr.example.com
HR_AUTH_REQUIRED=true
HR_DOCS_ENABLED=false
HR_ALLOWED_HOSTS=hr.example.com,web,127.0.0.1,localhost
HR_CORS_ORIGINS=https://hr.example.com

POSTGRES_DB=hr_agent
POSTGRES_USER=hr_agent
POSTGRES_PASSWORD=请生成高强度数据库密码
REDIS_PASSWORD=请生成高强度Redis密码

# 至少32个随机字符
HR_JWT_SECRET=请生成随机JWT签名密钥
# 首次初始化管理员时需要输入；成功后可从环境中删除
HR_BOOTSTRAP_TOKEN=请生成一次性初始化令牌
# 使用：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HR_DATA_ENCRYPTION_KEY=请生成Fernet密钥

DASHSCOPE_API_KEY=
HR_LLM_PROVIDER=bailian
HR_LANGCHAIN_MODEL=qwen-flash
HR_LANGCHAIN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

HR_SMTP_HOST=
HR_SMTP_PORT=587
HR_SMTP_USERNAME=
HR_SMTP_PASSWORD=
HR_SMTP_FROM=
HR_SMTP_USE_TLS=true
HR_SMS_WEBHOOK_URL=
